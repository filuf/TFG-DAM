<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.raj.slotify.fragments.general.FirstFragment"
        android:label="fragment_first"
        tools:layout="@layout/fragment_first" >
        <action
            android:id="@+id/action_firstFragment_to_languageFragment"
            app:destination="@id/languageFragment" />
        <action
            android:id="@+id/action_firstFragment_to_registryFragment2"
            app:destination="@id/registryFragment2" />
    </fragment>
    <fragment
        android:id="@+id/languageFragment"
        android:name="com.raj.slotify.fragments.general.LanguageFragment"
        android:label="fragment_language"
        tools:layout="@layout/fragment_language" />
    <fragment
        android:id="@+id/registryFragment2"
        android:name="com.raj.slotify.fragments.registry.userRegistry.RegistryFragment"
        android:label="fragment_registry"
        tools:layout="@layout/fragment_registry" />
</navigation>