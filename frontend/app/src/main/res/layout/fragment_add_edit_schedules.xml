                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inicio: --:--"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/wednesdayEndText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fin: --:--"
                            android:textSize="16sp" />
                    </LinearLayout>
                </TableRow>

                <!-- THURSDAY -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipThursday"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/thursday_word"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:id="@+id/thursdayChipLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/thursdayStartText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inicio: --:--"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/thursdayEndText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fin: --:--"
                            android:textSize="16sp" />
                    </LinearLayout>
                </TableRow>

                <!-- FRIDAY -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFriday"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/friday_word"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:id="@+id/fridayChipLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/fridayStartText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inicio: --:--"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/fridayEndText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fin: --:--"
                            android:textSize="16sp" />
                    </LinearLayout>
                </TableRow>

                <!-- SATURDAY -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSaturday"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/saturday_word"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:id="@+id/saturdayChipLayout"
